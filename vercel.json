{
    "version": 2,
    "outputDirectory": "public",
    "framework": null,
    "functions": {
      "api/index.php": {
        "runtime": "vercel-php@0.8.0"
      }
    },
    "routes": [
      {
        "src": "/(css|js|vendor|assets|build)/(.*)",
        "dest": "public/$1/$2"
      },
      {
        "src": "/(.*)",
        "dest": "api/index.php"
      }
    ],
    "_comment_crons": "Cron /ed/cron/liberar-vencidos pendiente de activacion y definicion de frecuencia segun plan de Vercel"
  }